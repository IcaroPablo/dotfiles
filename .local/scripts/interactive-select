#!/bin/sh

set -e

# portable helpers (have); guard.sh is optional, fall back to an inline have()
. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/guard.sh" 2>/dev/null || true
command -v have >/dev/null 2>&1 || have() { command -v "$1" >/dev/null 2>&1; }

COMMAND_FILE="$(mktemp)"

show_hidden=false
cmd="cat"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --show-hidden)
            show_hidden=true
            shift
            break;;
        *)
            break;;
    esac
done

# List entries. eza (with icons) when present, else plain ls. The icon prefix
# is 2 chars ("<icon> "), so STRIP removes it; without eza there is no prefix,
# so STRIP is a no-op (cat). Both the preview and the selection parser use it,
# keeping filenames intact either way.
if have eza; then
    STRIP='sed s/^..//'
    if [ "$show_hidden" = true ]; then
        items="$(eza -1 --group-directories-first --no-quotes --icons always -a)"
    else
        items="$(eza -1 --group-directories-first --no-quotes --icons always)"
    fi
else
    STRIP='cat'
    if [ "$show_hidden" = true ]; then
        items="$(ls -1A)"
    else
        items="$(ls -1)"
    fi
fi

raw_selection="$(mktemp)"
selection="$(mktemp)"

echo "$items" | fzf \
    --multi \
    --prompt="$(pwd)/" \
    --bind 'tab:toggle+clear-query+down' \
    --bind 'shift-tab:toggle+clear-query+up' \
    --bind 'ctrl-t:toggle-all' \
    --bind 'ctrl-e:deselect-all' \
    --bind 'alt-j:jump,jump:toggle' \
    --bind 'alt-g:first' \
    --bind 'alt-G:last' \
    --bind 'ctrl-h:print(....)+accept' \
    --bind 'alt-enter:execute(printf "command: "; read -r new_cmd; echo "$new_cmd" > '"$COMMAND_FILE"')+accept' \
    --bind 'ctrl-l:accept' \
    --height 100% \
    --color=bg+:-1 \
    --border=sharp \
    --info=inline \
    --reverse \
    --preview="echo {} | $STRIP | sed s/^/\'/ | sed s/$/\'/ | sed s/\ [^\']*//g | xargs preview" >> "$raw_selection"

if [ "$(cat $raw_selection)" != "" ]; then
    cat "$raw_selection" | $STRIP \
                         | sed s/^/\'/ \
                         | sed s/$/\'/ \
                         | xargs abspath >> "$selection"
fi

rm "$raw_selection"

new_command="$(cat $COMMAND_FILE)"

rm -f "$COMMAND_FILE"

if [ "$new_command" != "" ]; then
    cmd="$new_command"
elif [ "$1" != "" ]; then
    cmd="$@"
fi

# clean args
while [ "$#" -gt 0 ]; do
    shift
done

while IFS= read -r line; do
    set -- "$@" "$line"
done < "$selection"

if [ "$cmd" != "cat" ]; then
    $cmd "$@"
else
    cat "$selection"
fi

rm "$selection"
