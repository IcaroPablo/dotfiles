#!/bin/sh

set -e

. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/guard.sh" 2>/dev/null || true
command -v have >/dev/null 2>&1 || have() { command -v "$1" >/dev/null 2>&1; }
: "${CLIPFILE:=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/nav-clipboard}"

show_hidden=false
[ "$1" = "--show-hidden" ] && show_hidden=true

if have eza; then
    STRIP='sed s/^..//'
    if [ "$show_hidden" = true ]; then
        items="$(eza -1 --group-directories-first --no-quotes --icons always -a)"
    else
        items="$(eza -1 --group-directories-first --no-quotes --icons always)"
    fi
else
    STRIP='cat'
    if [ "$show_hidden" = true ]; then
        items="$(ls -1A)"
    else
        items="$(ls -1)"
    fi
fi

raw_selection="$(mktemp)"
selection="$(mktemp)"

echo "$items" | fzf \
    --multi \
    --prompt="$(pwd)/" \
    --bind 'tab:toggle+clear-query+down' \
    --bind 'shift-tab:toggle+clear-query+up' \
    --bind 'ctrl-t:toggle-all' \
    --bind 'ctrl-e:deselect-all' \
    --bind 'alt-j:jump,jump:toggle' \
    --bind 'alt-g:first' \
    --bind 'alt-G:last' \
    --bind 'ctrl-l:accept' \
    --height 100% \
    --color=bg+:-1 \
    --border=sharp \
    --info=inline \
    --reverse \
    --preview="echo {} | $STRIP | sed s/^/\'/ | sed s/$/\'/ | sed s/\ [^\']*//g | xargs preview" >> "$raw_selection"

if [ -s "$raw_selection" ]; then
    cat "$raw_selection" | $STRIP \
                         | sed s/^/\'/ \
                         | sed s/$/\'/ \
                         | xargs abspath >> "$selection"
fi
rm -f "$raw_selection"

if [ -s "$selection" ]; then
    tr '\n' '\0' < "$selection" > "$CLIPFILE"
    rm -f "$selection"
else
    rm -f "$selection"
    exit 1
fi
