#!/bin/sh
# create <name> — make a file, or a directory when <name> ends with '/'.
# With no argument, prompt for the name via fzf.

name="$1"
[ -z "$name" ] && name="$(fzf --print-query --prompt='name (dir ends with /): ' </dev/null)"
[ -z "$name" ] && exit 0

case "$name" in
    */) mkdir -p -- "$name" ;;
    *)  touch -- "$name" ;;
esac
