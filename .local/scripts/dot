#!/bin/sh
#
# dot — liga esta cópia do repositório à máquina, por symlinks.
#
# Usage:
#   dot link [--force]       cria os symlinks no $HOME
#   dot unlink               remove os symlinks que apontam para este repo
#   dot setup [--uninstall]  link + bloco no shell + doctor
#   dot doctor               o que está ligado, o que está instalado, o que falta
#
# POSIX sh only (dash/ksh/bash). Sem perl, sem bashismo.
#
# Não há manifesto de o-que-vai-onde: a lista de links sai da própria árvore do
# repositório (ver `targets`). Diretório novo em .config/ entra sozinho.

MARK_BEGIN="# >>> icaro-dotfiles >>>"
MARK_END="# <<< icaro-dotfiles <<<"

_OK='✓'
_NO='✗'

have() { command -v "$1" >/dev/null 2>&1; }

# resolve <caminho>: absoluto, com os symlinks resolvidos.
resolve() {
    if have realpath; then realpath "$1" 2>/dev/null && return 0; fi
    if readlink -f / >/dev/null 2>&1; then readlink -f "$1" 2>/dev/null && return 0; fi
    # BSD antigo, sem readlink -f: segue a cadeia na mão
    _r="$1"
    while [ -L "$_r" ]; do
        _l="$(readlink "$_r")"
        case "$_l" in
            /*) _r="$_l" ;;
            *)  _r="$(dirname "$_r")/$_l" ;;
        esac
    done
    (CDPATH= cd "$(dirname "$_r")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "$_r")")
}

# A raiz sai da localização deste script. Depois do `dot link` o dot é alcançado
# por ~/.local/scripts, que é symlink — resolver antes de subir dois níveis, ou
# a raiz daria no $HOME.
SELF="$(resolve "$0")"
REPO="${SELF%/.local/scripts/dot}"

if [ "$REPO" = "$SELF" ] || [ ! -e "$REPO/.git" ]; then
    printf 'dot: não achei a raiz do repositório a partir de %s\n' "$SELF" >&2
    exit 1
fi

usage() {
    cat <<'EOF'
dot liga estes dotfiles à máquina, por symlinks.

Usage:

    dot link [--force]       cria os symlinks no $HOME
    dot unlink               remove os symlinks que apontam para este repo
    dot setup [--uninstall]  link + bloco no shell + doctor
    dot doctor               o que está ligado, o que está instalado, o que falta

Versionar é git normal: cd no repositório e use o git.
EOF
}

# ------------------------------------------------------------------- symlinks

# Arquivos de topo que alguma ferramenta exige no $HOME. O .xinitrc está aqui
# porque o startx do OpenBSD não lê o $XDG_CONFIG_HOME/xinitrc — só o ~/.xinitrc.
TOP_LEVEL='.xinitrc'

# targets: um alvo por linha, relativo à raiz do repositório.
targets() {
    for _d in "$REPO"/.config/*/ "$REPO"/.local/*/; do
        [ -d "$_d" ] || continue
        _d="${_d%/}"
        printf '%s\n' "${_d#$REPO/}"
    done
    for _f in $TOP_LEVEL; do
        [ -e "$REPO/$_f" ] && printf '%s\n' "$_f"
    done
}

# linked <rel>: verdadeiro se o $HOME já tem o link certo para o repositório.
linked() {
    [ -L "$HOME/$1" ] || return 1
    [ "$(resolve "$HOME/$1")" = "$(resolve "$REPO/$1")" ]
}

link() {
    _force=0
    [ "$1" = "--force" ] && _force=1

    _bad=0
    _ifs="$IFS"; IFS='
'
    for _rel in $(targets); do
        _dst="$HOME/$_rel"

        if linked "$_rel"; then
            printf '  =  %s\n' "$_rel"
            continue
        fi

        if [ -e "$_dst" ] || [ -L "$_dst" ]; then
            if [ "$_force" = 1 ]; then
                _bak="$_dst.dot-bak.$(date +%Y%m%d%H%M%S)"
                mv -- "$_dst" "$_bak" || { _bad=1; continue; }
                printf '  ~  %s  (o que estava aí virou %s)\n' "$_rel" "${_bak##*/}"
            else
                printf '  !  %s  existe e não é o link — use --force pra mover de lado\n' "$_rel"
                _bad=1
                continue
            fi
        fi

        mkdir -p -- "$(dirname -- "$_dst")"
        if ln -s -- "$REPO/$_rel" "$_dst"; then
            printf '  +  %s\n' "$_rel"
        else
            _bad=1
        fi
    done
    IFS="$_ifs"

    [ "$_bad" = 0 ]
}

# Só remove o que aponta para este repositório: link alheio no mesmo caminho
# fica onde está.
unlink_all() {
    _ifs="$IFS"; IFS='
'
    for _rel in $(targets); do
        if linked "$_rel"; then
            rm -- "$HOME/$_rel" && printf '  -  %s\n' "$_rel"
        fi
    done
    IFS="$_ifs"
}

# -------------------------------------------------------------- shell wiring

detect_shell() {
    _sh="${SHELL:-}"
    [ -z "$_sh" ] && _sh="$(ps -p "$$" -o comm= 2>/dev/null)"
    basename "$_sh" 2>/dev/null
}

rc_path_for() {
    case "$1" in
        zsh)  printf '%s\n' "${ZDOTDIR:-$HOME}/.zshrc" ;;
        bash) printf '%s\n' "$HOME/.bashrc" ;;
        ksh|ksh93|oksh|mksh|pdksh|sh) printf '%s\n' "$HOME/.kshrc" ;;
        *)    printf '%s\n' "$HOME/.${1}rc" ;;
    esac
}

profile_path_for() {
    case "$1" in
        zsh)  printf '%s\n' "${ZDOTDIR:-$HOME}/.zprofile" ;;
        bash) printf '%s\n' "$HOME/.bash_profile" ;;
        *)    printf '%s\n' "$HOME/.profile" ;;
    esac
}

inject_block() {
    _file="$1"; _line="$2"
    if [ -f "$_file" ] && grep -qF "$MARK_BEGIN" "$_file" 2>/dev/null; then
        printf '  %s [bloco já presente]\n' "$_file"
        return 0
    fi
    printf '\n%s\n%s\n%s\n' "$MARK_BEGIN" "$_line" "$MARK_END" >> "$_file"
    printf '  %s [bloco injetado]\n' "$_file"
}

remove_block() {
    _file="$1"
    [ -f "$_file" ] || return 0
    grep -qF "$MARK_BEGIN" "$_file" 2>/dev/null || return 0
    _tmp="$(mktemp)"
    awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
        $0==b {skip=1; next}
        $0==e {skip=0; next}
        skip!=1 {print}
    ' "$_file" > "$_tmp" && cat "$_tmp" > "$_file"
    rm -f "$_tmp"
    printf '  %s [bloco removido]\n' "$_file"
}

setup() {
    _shell="$(detect_shell)"
    _rc="$(rc_path_for "$_shell")"
    _profile="$(profile_path_for "$_shell")"

    case "$1" in
        --uninstall)
            printf 'icaro-dotfiles :: setup --uninstall (shell: %s)\n\n' "$_shell"
            printf 'shell\n'
            remove_block "$_rc"
            remove_block "$_profile"
            printf '\nsymlinks\n'
            unlink_all
            return 0 ;;
    esac

    printf 'icaro-dotfiles :: setup\n  repo:  %s\n  shell: %s\n\n' "$REPO" "$_shell"

    printf 'symlinks\n'
    if ! link "$@"; then
        printf '\nsetup: resolva os conflitos acima, ou repita com --force.\n' >&2
        return 1
    fi

    printf '\nshell\n'
    case "$_shell" in
        ksh|ksh93|oksh|mksh|pdksh|sh)
            # ksh/sh have no separate interactive rc file — the profile points
            # $ENV at rc.sh (que re-puxa o env.sh de forma idempotente) e só
            # depois carrega o env.sh.
            #
            # A ordem importa: o env.sh termina no auto-startx do tty1, que
            # bloqueia até a sessão do X morrer. Com o export depois, o ENV só
            # valeria no logout, e todo terminal aberto dentro do X herdaria ENV
            # vazio — shell interativo sem rc nenhum.
            inject_block "$_profile" \
"ENV=\"\$HOME/.config/sh/rc.sh\"; export ENV
. \"\$HOME/.config/sh/env.sh\"" ;;
        *)
            inject_block "$_profile" ". \"\$HOME/.config/sh/env.sh\""
            inject_block "$_rc" ". \"\$HOME/.config/sh/rc.sh\"" ;;
    esac

    printf '\n'
    doctor
}

# -------------------------------------------------------------------- doctor

# present <cmd>: verdadeiro se a ferramenta (ou um substituto aceito) existe.
present() {
    case "$1" in
        fd)     have fd || have fdfind ;;
        zoxide) have zoxide || { have lua && [ -f "$HOME/.local/bin/z.lua" ]; } ;;
        *)      have "$1" ;;
    esac
}

# report_group <rótulo> <ferramenta...>: ✓/✗ por ferramenta. Retorna não-zero se
# faltar alguma. Sem instruções de instalação: cada máquina tem o seu gerenciador
# e as tabelas por SO envelheciam mais rápido do que eram lidas.
report_group() {
    _label="$1"; shift
    _missing=""
    printf '%s\n  ' "$_label"
    for _t in "$@"; do
        if present "$_t"; then
            printf '%s %s  ' "$_OK" "$_t"
        else
            printf '%s %s  ' "$_NO" "$_t"
            _missing="$_missing $_t"
        fi
    done
    printf '\n\n'
    [ -z "$_missing" ]
}

_block_status() {
    if [ -f "$1" ] && grep -qF "$MARK_BEGIN" "$1" 2>/dev/null; then
        printf '  %s %s\n' "$_OK" "$1"
    else
        printf '  %s %s\n' "$_NO" "$1"
    fi
}

link_status() {
    printf 'symlinks\n'
    _ifs="$IFS"; IFS='
'
    for _rel in $(targets); do
        if linked "$_rel"; then
            printf '  %s %s\n' "$_OK" "$_rel"
        else
            printf '  %s %s\n' "$_NO" "$_rel"
        fi
    done
    IFS="$_ifs"
    printf '\n'
}

doctor() {
    printf 'icaro-dotfiles :: doctor (%s)\n  repo: %s\n\n' "$(uname)" "$REPO"

    link_status

    _core=1
    report_group "CORE" git fzf eza nvim tree-sitter bat file mktemp dvtm || _core=0
    report_group "NÚCLEO" fd zoxide readlink make lsof carapace || :
    report_group "PREVIEW (opcional — recursos degradam sem)" \
        w3m exiftool unzip tar pixterm || :

    case "$(uname)" in
        Darwin)  report_group "OS/desktop (Darwin)" open || : ;;
        Linux)   report_group "OS/desktop (Linux)" xdg-open flatpak xclip || : ;;
        OpenBSD) report_group "OS/desktop (OpenBSD)" doas || : ;;
    esac

    _shell="$(detect_shell)"
    printf 'shell (%s)\n' "$_shell"
    _block_status "$(rc_path_for "$_shell")"
    _block_status "$(profile_path_for "$_shell")"

    printf '\n'
    if [ "$_core" = 1 ]; then
        printf 'CORE completo.\n'
        return 0
    fi
    printf 'falta dependência do CORE.\n'
    return 1
}

# ------------------------------------------------------------------ dispatch

case "${1:-}" in
    ""|-h|--help|help) usage ;;
    link)    shift; link "$@" ;;
    unlink)  unlink_all ;;
    setup)   shift; setup "$@" ;;
    doctor)  doctor ;;
    *)       printf 'dot: verbo desconhecido: %s\n\n' "$1" >&2; usage; exit 1 ;;
esac
