#!/bin/sh
# bulkrename — edit filenames in $EDITOR and apply the renames. Operates on lf's
# selection ($fs) when set, otherwise on every entry in the current directory.

old="$(mktemp)"; new="$(mktemp)"
trap 'rm -f "$old" "$new"' EXIT

if [ -n "${fs:-}" ]; then
    printf '%s\n' "$fs" | while IFS= read -r f; do basename -- "$f"; done > "$old"
else
    ls > "$old"
fi
cp -- "$old" "$new"

"${EDITOR:-vi}" "$new"

[ "$(wc -l < "$old")" -eq "$(wc -l < "$new")" ] || {
    echo "bulkrename: line count changed, aborting" >&2
    exit 1
}

paste "$old" "$new" | while IFS="$(printf '\t')" read -r src dst; do
    [ "$src" = "$dst" ] || [ -e "$dst" ] || mv -- "$src" "$dst"
done

command -v lf >/dev/null 2>&1 && [ -n "${id:-}" ] && lf -remote "send $id unselect"
