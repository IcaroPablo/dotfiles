#!/bin/sh
# requires X11

FPS=15
PIDFILE="${TMPDIR:-/tmp}/rec_gif.pid"
RAW="${TMPDIR:-/tmp}/rec_gif.mkv"

if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    kill -INT "$(cat "$PIDFILE")"
    while kill -0 "$(cat "$PIDFILE")" 2>/dev/null; do sleep 0.2; done
    rm -f "$PIDFILE"

    out="$HOME/$(date +%Y-%m-%d_%H-%M-%S).gif"
    palette="${TMPDIR:-/tmp}/rec_gif_palette.png"
    ffmpeg -y -i "$RAW" -vf "fps=$FPS,palettegen" "$palette" >/dev/null 2>&1
    ffmpeg -y -i "$RAW" -i "$palette" -lavfi "fps=$FPS[x];[x][1:v]paletteuse" "$out" >/dev/null 2>&1
    xclip -selection clipboard -target image/gif -i "$out"
    rm -f "$RAW" "$palette"
    exit 0
fi

coords="$(slop -f '%x %y %w %h')" || exit 1
set -- $coords
X=$1; Y=$2; W=$3; H=$4

ffmpeg -y -f x11grab -framerate "$FPS" -video_size "${W}x${H}" -i ":0.0+$X,$Y" -c:v ffv1 "$RAW" >/dev/null 2>&1 &
echo $! > "$PIDFILE"
