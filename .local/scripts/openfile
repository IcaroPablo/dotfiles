# setsid não funciona

# portable helpers (have/os_open/mimetype); fall back to an inline opener if absent
. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/guard.sh" 2>/dev/null || true
if ! command -v os_open >/dev/null 2>&1; then
    os_open() {
        case "$(uname)" in
            Darwin) open "$@" ;;
            *) for _f in "$@"; do xdg-open "$_f" >/dev/null 2>&1 & done ;;
        esac
    }
fi

# for current in "$@"; do
#     escaped_term="$(echo "$current" | sed 's/ /\\ /g')"
#     escaped_terms="$escaped_terms $escaped_term"
# done

handlenoextension() {
    case "$(mimetype "$1")" in
        # text/*)
        #     batorcat "$1"
        #     break ;;
        inode/directory)
            echo "$1"
            break ;;
        *) os_open "$@" ;;
    esac
}

first="$1"

test -L "$first" && first="$(abspath "$first")"

case "$(mimetype "$first")" in
    inode/x-empty|text/*|application/json|*shellscript|application/x-empty|application/octet-stream) launch_nvim "$@" ;;
    application/pdf|application/vnd.djvu|application/epub*) have zathura && zathura "$@" || os_open "$@" ;;
    audio/*|video/x-ms-asf) have mpv && mpv --shuffle --no-audio-display "$@" || os_open "$@" ;;
    video/*) have mpv && mpv "$@" >/dev/null 2>&1 || os_open "$@" ;;
    image/*) have nsxiv && nsxiv -a --thumbnail "$@" || os_open "$@" ;;
	*) handlenoextension "$@" ;;
    # *) for f in $@ ; do setsid xdg-open "$f" > /dev/null 2> /dev/null & done ;;
    # *) for f in $fx; do setsid -f $OPENER $f >/dev/null 2>&1; done;;
esac
