#!/bin/sh
#
# shpad - abre o editor num painel ao lado e passa a ler comandos dele.
#
# Script e não função: como função o exec trocava o SEU shell interativo pelo
# broker. Assim ele é filho, e ao sair você volta pro shell de onde chamou.

set -e

SHPAD_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/sh/shpad"
SHPAD_HISTORY="${SHPAD_HISTORY:-$HOME/.local/share/history.sh}"
SHPAD_FIFO="${TMPDIR:-/tmp}/shpad.$$.fifo"

if [ -z "$DVTM_CMD_FIFO" ]; then
    printf 'shpad: só funciona dentro do dvtm (DVTM_CMD_FIFO vazio)\n' >&2
    exit 1
fi

if [ ! -x "$SHPAD_HOME/shpad-run" ]; then
    printf 'shpad: não compilado -- rode `make -C %s`\n' "$SHPAD_HOME" >&2
    exit 1
fi

mkdir -p "${SHPAD_HISTORY%/*}"
[ -e "$SHPAD_HISTORY" ] || : > "$SHPAD_HISTORY"

# `env` inline porque o painel que o dvtm cria herda o ambiente DELE. O segundo
# argumento é o título, senão a janela leva o basename do comando inteiro.
printf 'create "env SHPAD_FIFO=%s %s %s" shpad\n' \
    "$SHPAD_FIFO" "${EDITOR:-nvim}" "$SHPAD_HISTORY" > "$DVTM_CMD_FIFO"

# O shpad-run cria o fifo e o remove ao sair; o editor só o procura ao mandar.
exec "$SHPAD_HOME/shpad-run" "$SHPAD_FIFO"
