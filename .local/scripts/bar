#!/bin/sh
# requires X11

battery="${BATTERY:-BAT0}"
have() { command -v "$1" >/dev/null 2>&1; }

get_uptime()     { printf 'uptime: %s | ' "$(uptime | sed -e 's/^.*up //' -e 's/,.*$//' -e 's/^ *//')"; }

get_ram() {
    if have free; then printf 'RAM: %s | ' "$(free -h | awk '/^Mem/{print $3}' | sed 's/i//')"
    elif have top; then printf 'RAM: %s | ' "$(top -d 1 2>/dev/null | awk '/Memory/{print $3; exit}')"; fi
}

get_network() {
    if have nmcli; then printf 'net: %s | ' "$(nmcli -t -f NAME c show --active 2>/dev/null | head -n1)"
    elif have ifconfig; then printf 'net: %s | ' "$(ifconfig 2>/dev/null | awk '/status: active/{print "up"; exit}')"; fi
}

get_brightness() { have xbacklight && printf 'screen: %s%% | ' "$(xbacklight -get | sed 's/\..*$//')"; }

get_volume() {
    if have pactl; then printf 'sound: %s | ' "$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '{print $5; exit}')"
    elif have sndioctl; then
        v="$(sndioctl -n output.level 2>/dev/null)"
        [ -n "$v" ] && printf 'sound: %s%% | ' "$(awk -v p="$v" 'BEGIN{printf "%.0f", p*100}')"
    fi
}

get_battery() {
    if [ -r "/sys/class/power_supply/$battery/capacity" ]; then
        printf 'battery: %s%% (%s) | ' \
            "$(cat "/sys/class/power_supply/$battery/capacity")" \
            "$(cat "/sys/class/power_supply/$battery/status")"
    elif have apm; then printf 'battery: %s%% | ' "$(apm -l 2>/dev/null)"; fi
}

get_datetime()   { date +"%a %d %b %Y | %I:%M %p (%Z GMT)"; }

status()  { printf ' %s%s%s%s%s%s%s' "$(get_uptime)" "$(get_ram)" "$(get_network)" "$(get_brightness)" "$(get_volume)" "$(get_battery)" "$(get_datetime)"; }
refresh() { xsetroot -name "$(status)"; }

mkdir -p "$HOME/.cache"
printf '%s\n' "$$" > "$HOME/.cache/barpid"

trap refresh 30
while :; do
    refresh
    sleep 1 & wait
done
