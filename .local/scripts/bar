#!/bin/sh
# requires X11

battery="${BATTERY:-BAT0}"
have() { command -v "$1" >/dev/null 2>&1; }

get_uptime()     { printf 'uptime: %s | ' "$(uptime | sed -e 's/^.*up //' -e 's/,.*$//' -e 's/^ *//')"; }

get_ram() {
    if have free; then printf 'RAM: %s | ' "$(free -h | awk '/^Mem/{print $3}' | sed 's/i//')"
    elif have top; then printf 'RAM: %s | ' "$(top -d 1 2>/dev/null | awk '/Memory/{print $3; exit}')"; fi
}

get_network() {
    if have nmcli; then printf 'net: %s | ' "$(nmcli -t -f NAME c show --active 2>/dev/null | head -n1)"
    elif have ifconfig; then printf 'net: %s | ' "$(ifconfig 2>/dev/null | awk '/status: active/{print "up"; exit}')"; fi
}

# Três fontes, da mais específica para a mais genérica. O xbacklight sozinho não
# serve: quando não há propriedade de backlight no RandR ele falha no stderr e
# devolve string vazia, e o valor saía como "screen: %".
get_brightness() {
    for _b in /sys/class/backlight/*/; do
        [ -r "$_b/brightness" ] && [ -r "$_b/max_brightness" ] || continue
        awk -v c="$(cat "$_b/brightness")" -v m="$(cat "$_b/max_brightness")" \
            'BEGIN { if (m > 0) printf "screen: %.0f%% | ", c * 100 / m }'
        return
    done

    if have xbacklight; then
        _v="$(xbacklight -get 2>/dev/null)"
        [ -n "$_v" ] && { printf 'screen: %s%% | ' "${_v%%.*}"; return; }
    fi

    # Brilho por software (gamma do X): é o que o `monitor bright` mexe, e a
    # única fonte que sobra numa máquina sem backlight de hardware. Lê o output
    # que está de fato ligado — o que tem geometria —, não o primeiro conectado.
    if have xrandr; then
        _v="$(xrandr --verbose 2>/dev/null |
            awk '/^[A-Za-z0-9-]+ connected/ { a = ($0 ~ /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) }
                 a && /Brightness:/ { print $2; exit }')"
        [ -n "$_v" ] && printf 'screen: %s%% | ' "$(awk -v p="$_v" 'BEGIN{printf "%.0f", p*100}')"
    fi
}

get_volume() {
    if have pactl; then
        _v="$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '{print $5; exit}')"
        if [ -n "$_v" ]; then
            case "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null)" in
                *yes) printf 'sound: muted | ' ;;
                *)    printf 'sound: %s | ' "$_v" ;;
            esac
            return
        fi
    fi

    if have wpctl; then
        _v="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
        case "$_v" in
            *MUTED*)  printf 'sound: muted | ' ; return ;;
            Volume:*) printf 'sound: %s%% | ' \
                          "$(awk -v p="${_v#Volume: }" 'BEGIN{printf "%.0f", p*100}')"
                      return ;;
        esac
    fi

    if have amixer; then
        # nível e estado numa chamada só: o bar redesenha a cada segundo
        _v="$(amixer get Master 2>/dev/null |
            awk -F'[][]' '/Playback .*%/{ print $2, $4; exit }')"
        if [ -n "$_v" ]; then
            case "$_v" in
                *\ off) printf 'sound: muted | ' ;;
                *)      printf 'sound: %s | ' "${_v% *}" ;;
            esac
            return
        fi
    fi

    if have sndioctl; then
        _v="$(sndioctl -n output.level 2>/dev/null)"
        [ -n "$_v" ] && printf 'sound: %s%% | ' "$(awk -v p="$_v" 'BEGIN{printf "%.0f", p*100}')"
    fi
}

get_battery() {
    if [ -r "/sys/class/power_supply/$battery/capacity" ]; then
        printf 'battery: %s%% (%s) | ' \
            "$(cat "/sys/class/power_supply/$battery/capacity")" \
            "$(cat "/sys/class/power_supply/$battery/status")"
    elif have apm; then printf 'battery: %s%% | ' "$(apm -l 2>/dev/null)"; fi
}

get_datetime()   { date +"%a %d %b %Y | %I:%M %p (%Z GMT)"; }

status()  { printf ' %s%s%s%s%s%s%s' "$(get_uptime)" "$(get_ram)" "$(get_network)" "$(get_brightness)" "$(get_volume)" "$(get_battery)" "$(get_datetime)"; }
refresh() { xsetroot -name "$(status)"; }

mkdir -p "$HOME/.cache"
printf '%s\n' "$$" > "$HOME/.cache/barpid"

trap refresh 30
while :; do
    refresh
    sleep 1 & wait
done
