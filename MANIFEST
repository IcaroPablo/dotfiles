# What make links, and where: one line per file or folder.
#
#   path : needs
#
# needs are capabilities this machine declared (~/.config/dotfiles/capabilities,
# written by setup/<os>; their checks are in the Makefile) and OS tags (linux
# openbsd macos, from uname); a|b is either one. A file with no needs is linked
# everywhere.

.config/git                   :
.config/sh                    :
.config/nvim                  : text-editing
.config/vis                   : text-editing
