#!/bin/sh
# Inside an nvim's terminal ($NVIM set), opens the files in that nvim instead of
# a nested one; anywhere else it's plain nvim.

. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/guard.sh" || exit 1

if [ -n "$NVIM" ] && [ "$#" -gt 0 ]; then
	n=$#
	while [ "$n" -gt 0 ]; do set -- "$@" "$(abspath "$1")"; shift; n=$((n - 1)); done
	exec nvim --server "$NVIM" --remote "$@"
fi
exec nvim "$@"
