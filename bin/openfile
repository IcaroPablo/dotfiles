#!/bin/sh

. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/core.sh" || exit 1
. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/x11.sh" || exit 1

# written by fangorn rebuild: media under $root plays on the host's screen
remote="${XDG_CONFIG_HOME:-$HOME/.config}/openfile/remote"

send_remote() {
    [ -f "$remote" ] || return 1
    . "$remote"
    _sr_root=$(abspath "$root")
    _sr_list=
    for _f in "$@"; do
        _sr_f=$(abspath "$_f")
        case "$_sr_f" in
            *"
"*) return 1 ;;
            "$_sr_root"/*) _sr_list="$_sr_list${_sr_f#"$_sr_root"/}
" ;;
            *) return 1 ;;
        esac
    done
    printf '%s' "$_sr_list" | ssh -i "$key" -o IdentitiesOnly=yes -o BatchMode=yes \
        -o ConnectTimeout=3 -o UserKnownHostsFile="$known" -o StrictHostKeyChecking=yes \
        "$host" 2>/dev/null
}

noscreen() { printf 'openfile: no screen here for %s\n' "$1" >&2; return 1; }

first="$1"

case "$(mimetype "$first")" in
    inode/directory) printf '%s\n' "$first" ;;
    inode/x-empty|text/*|application/json|*shellscript|application/x-empty|application/octet-stream)
        if have nvim && have launch_nvim; then launch_nvim "$@"
        else ${VISUAL:-${EDITOR:-vi}} "$@"; fi ;;
    # before image/*: file calls DjVu an image
    application/pdf|image/vnd.djvu*|application/vnd.djvu*|application/epub*)
        if have spdfv && [ -t 0 ]; then for _f in "$@"; do spdfv "$_f"; done
        elif has_x; then gui_open "$@"
        else noscreen "$first"; fi ;;
    # mpv's exit status says how it was quit, not whether it could play: once
    # it ran, nothing else opens the files
    audio/*|video/x-ms-asf)
        send_remote "$@" && exit
        if have mpv; then mpv --shuffle --no-audio-display "$@"
        else gui_open "$@" || noscreen "$first"; fi ;;
    video/*)
        send_remote "$@" && exit
        if has_x && have mpv; then mpv "$@" >/dev/null 2>&1
        elif has_x; then gui_open "$@"
        elif have mpv; then mpv --vo=tct --really-quiet "$@"
        else noscreen "$first"; fi ;;
    image/*)
        if have sixiv && [ -t 0 ]; then
            if [ $# -gt 1 ]; then sixiv -t -- "$@"; else sixiv -- "$1"; fi
        else gui_open "$@" || for _f in "$@"; do preview "$_f"; done; fi ;;
    *) gui_open "$@" || for _f in "$@"; do preview "$_f"; done ;;
esac
