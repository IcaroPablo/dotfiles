#!/bin/sh
# requires X11 (macOS uses screencapture)

. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/guard.sh" || exit 1

case "$(uname)" in
    Darwin)
        screencapture -i -c
        ;;
    *)
        if have scrot; then
            scrot -f -s -q 100 -e 'xclip -selection clipboard -target image/png -i $f && rm $f'
        else
            echo "scr_shot: scrot not found" >&2
            exit 1
        fi
        ;;
esac
