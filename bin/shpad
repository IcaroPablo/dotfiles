#!/bin/sh

set -e

SHPAD_HISTORY="${SHPAD_HISTORY:-$HOME/.shpad_history}"

if [ -z "$DVTM_CMD_FIFO" ]; then
    printf 'shpad: só funciona dentro do dvtm (DVTM_CMD_FIFO vazio)\n' >&2
    exit 1
fi

# `env` inline porque o painel que o dvtm cria herda o ambiente DELE. Os dois
# valores que o editor não teria como descobrir sozinho existem só aqui: o
# DVTM_WINDOW_ID deste painel, que é para onde os comandos vão, e o $PPID, que é o
# shell contra o qual a completion resolve. O último argumento é o título, senão a
# janela leva o basename do comando inteiro; o `+` abre o histórico na última
# linha, onde você parou.
printf 'create "env SHPAD_SHELL_WIN=%s SHPAD_SHELL_PID=%s %s + %s" shpad\n' \
    "$DVTM_WINDOW_ID" "$PPID" "${EDITOR:-nvim}" "$SHPAD_HISTORY" \
    > "$DVTM_CMD_FIFO"

# Agora o painel encolhe para caber o editor, e o SIGWINCH chega AQUI: em primeiro
# plano está este script, não o shell que o chamou. Sem repassar o aviso, o shell
# desenha o próximo prompt com a largura antiga e o `%` de "linha parcial" fica na
# tela -- apagá-lo é preencher até o fim da linha, e a conta sai errada. Depois de
# sair é tarde: o `%` já está lá.
#
# Esperar pelo sinal em vez de dormir um tanto fixo: o `wait` é interrompido quando
# ele chega, e o `sleep` é só o teto para o caso de nunca vir.
trap ':' WINCH
sleep 2 &
winch=$!
wait "$winch" 2>/dev/null || true
kill "$winch" 2>/dev/null || true
kill -WINCH "$PPID" 2>/dev/null || true
