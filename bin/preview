#!/bin/sh
# preview <file>, for fzf; every tool is optional

. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/core.sh" || exit 1

desc() { have file && file -Lb "$1" || mimetype "$1" || printf '%s\n' "$1"; }

image() {
    if have chafa; then
        chafa -f symbols ${FZF_PREVIEW_COLUMNS:+-s "${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}"} "$1" 2>/dev/null ||
            desc "$1"
    else
        desc "$1"
    fi
}

meta() {
    if have exiftool; then exiftool "$1"
    elif have ffprobe; then ffprobe -hide_banner "$1" 2>&1
    else desc "$1"; fi
}

# 2x2 grid of frames at 10, 35, 60 and 85%
video() {
    have ffmpeg && have ffprobe && have chafa || { meta "$1"; return; }
    _vd=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$1" 2>/dev/null)
    _vf="$1"
    _vt=$(mktemp) || { meta "$_vf"; return; }
    trap 'rm -f "$_vt"' EXIT
    set --
    for _vs in $(awk -v d="$_vd" 'BEGIN { if (d > 0) print d*.10, d*.35, d*.60, d*.85 }'); do
        set -- "$@" -ss "$_vs" -i "$_vf"
    done
    if [ $# -eq 16 ] && ffmpeg -v error -y "$@" -filter_complex \
        '[0:v]scale=240:-2[a];[1:v]scale=240:-2[b];[2:v]scale=240:-2[c];[3:v]scale=240:-2[d];[a][b][c][d]xstack=inputs=4:layout=0_0|w0_0|0_h0|w0_h0' \
        -frames:v 1 -update 1 -f image2 -c:v png "$_vt" 2>/dev/null && [ -s "$_vt" ]; then
        image "$_vt"
    else
        meta "$_vf"
    fi
}

# media by content, so one extension table (core.sh's, for systems without
# file) serves openfile and preview alike
bytype() {
    case "$(mimetype "$1")" in
        text/*) cat "$1" ;;
        inode/directory)
            if have eza; then eza -1 --group-directories-first --no-quotes --icons always -a "$1"
            else ls -1A "$1"; fi ;;
        image/vnd.djvu*) desc "$1" ;;
        image/*) image "$1" ;;
        video/*) video "$1" ;;
        audio/*) meta "$1" ;;
        *) desc "$1" ;;
    esac
}

name=$1
[ -L "$1" ] && name=$(abspath "$1")

# what file can't tell apart: archives by their compression, and formats
# better shown by a tool than by their bytes
case "$(printf '%s\n' "$name" | tr '[:upper:]' '[:lower:]')" in
    *.tgz|*.tar.gz) have tar && tar tzf "$1" || desc "$1" ;;
    *.tar.bz2|*.tbz2) have tar && tar tjf "$1" || desc "$1" ;;
    *.tar.xz|*.txz) have xz && xz -dc "$1" | tar tf - || desc "$1" ;;
    *.tar) have tar && tar tf "$1" || desc "$1" ;;
    *.zip|*.jar|*.war|*.ear|*.oxt) have unzip && unzip -l "$1" || desc "$1" ;;
    *.gz) have gzip && gzip -l "$1" || desc "$1" ;;
    *.rar) have unrar && unrar l "$1" || desc "$1" ;;
    *.7z) have 7z && 7z l "$1" || desc "$1" ;;
    *.[1-8]) have man && man -l "$1" | col -b || desc "$1" ;;
    *.o) have nm && nm "$1" || desc "$1" ;;
    *.iso) have iso-info && iso-info --no-header -l "$1" || desc "$1" ;;
    *.xml|*.html) have w3m && w3m -dump "$1" || cat "$1" ;;
    *) bytype "$1" ;;
esac

exit 0
