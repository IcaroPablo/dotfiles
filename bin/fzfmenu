#!/bin/sh
# requires X11
# fzf in a floating st window, as dmenu: lines on stdin, the choice on stdout.
# The arguments go to fzf, parsed again by sh, so quote them for it.
# FZFMENU_SIZE is the window's size in columns and rows (50x30). The window
# asks for no position, and smawm centers such a window below its bar.

in="$(mktemp)"; out="$(mktemp)"
trap 'rm -f "$in" "$out"' EXIT

cat > "$in"

st -i -g "${FZFMENU_SIZE:-50x30}" -e sh -c "fzf $* < '$in' > '$out'"

cat "$out"
