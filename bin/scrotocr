#!/bin/sh
# requires X11 + tesseract
#
# scrotocr [lang] — recorta uma região da tela, passa OCR nela e joga o texto
# no clipboard. O idioma é o primeiro argumento (padrão: eng); `tesseract
# --list-langs` mostra os instalados.

. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/core.sh" || exit 1
. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/x11.sh" || exit 1

lang="${1:-eng}"

for dep in scrot mogrify tesseract; do
    have "$dep" || {
        printf 'scrotocr: %s not found\n' "$dep" >&2
        exit 1
    }
done

img="$(mktemp)"
trap 'rm -f "$img" "$img.png" "$img.txt"' EXIT

scrot -s -q 100 "$img.png" || exit 1

# Amplia e tira a saturação antes do OCR: em texto pequeno a taxa de acerto do
# tesseract cai muito, e o resize de 400% é o que mais ajuda.
mogrify -modulate 100,0 -resize 400% "$img.png"

tesseract "$img.png" "$img" -l "$lang" >/dev/null 2>&1 || {
    printf 'scrotocr: tesseract failed (is language "%s" installed?)\n' "$lang" >&2
    exit 1
}

clip_copy "$img.txt"
