#!/bin/sh
# requires X11
#
# monitor off|on|bright VALUE|scale FACTOR|same
#
# Os nomes dos outputs não são fixos — mudam com a máquina (eDP-1, LVDS1,
# HDMI-A-0) e o painel interno pode nem existir. Nada aqui é hardcoded: cada
# verbo resolve o output que lhe cabe e reclama quando ele não existe.

# O xrandr só imprime geometria (1920x1080+0+0) para output que está aceso:
# conectado mas --off não tem nenhuma. É esse o teste de "está em uso".
# Entre vários acesos, o primário ganha — é a tela em que você está.
active() {
    xrandr 2>/dev/null | awk '
        / connected/ && /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/ {
            if (!first) first = $1
            if ($0 ~ / primary /) pri = $1
        }
        END { if (pri) print pri; else if (first) print first }'
}

# Painel embutido: eDP (moderno), LVDS (antigo), DSI (tablet/ARM).
internal() { xrandr 2>/dev/null | awk '/ connected/ && $1 ~ /^(eDP|LVDS|DSI)/  { print $1; exit }'; }
external() { xrandr 2>/dev/null | awk '/ connected/ && $1 !~ /^(eDP|LVDS|DSI)/ { print $1; exit }'; }

# need <valor> <o que faltou>
need() {
    [ -n "$1" ] && return 0
    printf 'monitor: %s\n' "$2" >&2
    exit 1
}

usage() { echo "usage: monitor off|on|bright VALUE|scale FACTOR|same" >&2; exit 1; }

case "$1" in
    off)
        o="$(internal)"; need "$o" "no internal panel (eDP/LVDS/DSI) connected"
        xrandr --output "$o" --off ;;
    on)
        o="$(internal)"; need "$o" "no internal panel (eDP/LVDS/DSI) connected"
        xrandr --output "$o" --auto ;;
    bright)
        [ -n "$2" ] || usage
        o="$(active)"; need "$o" "no output is on"
        xrandr --output "$o" --brightness "$2" ;;
    scale)
        [ -n "$2" ] || usage
        o="$(active)"; need "$o" "no output is on"
        xrandr --output "$o" --scale "$2x$2" ;;
    same)
        i="$(internal)"; need "$i" "no internal panel to mirror"
        e="$(external)"; need "$e" "no external monitor connected"
        xrandr --output "$e" --same-as "$i" ;;
    *)  usage ;;
esac
