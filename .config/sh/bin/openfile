#!/bin/sh

. "${XDG_CONFIG_HOME:-$HOME/.config}/sh/lib/guard.sh" 2>/dev/null || true
if ! command -v os_open >/dev/null 2>&1; then
    os_open() {
        case "$(uname)" in
            Darwin) open "$@" ;;
            *) for _f in "$@"; do xdg-open "$_f" >/dev/null 2>&1 & done ;;
        esac
    }
fi

# ~/.config/openfile/remote (sh), written by fangorn rebuild na VM: mídia sob
# $root abre na tela de outra máquina, por ssh ($host, com $key, conferindo $known)
remote="${XDG_CONFIG_HOME:-$HOME/.config}/openfile/remote"

# manda os arquivos para a tela remota; falha calado se não há remote, se algum
# está fora de $root ou se a máquina não responde, e quem chamou se vira aqui
send_remote() {
    [ -f "$remote" ] || return 1
    . "$remote"
    _sr_root=$(abspath "$root")
    _sr_list=
    for _f in "$@"; do
        _sr_f=$(abspath "$_f")
        case "$_sr_f" in
            *"
"*) return 1 ;;
            "$_sr_root"/*) _sr_list="$_sr_list${_sr_f#"$_sr_root"/}
" ;;
            *) return 1 ;;
        esac
    done
    printf '%s' "$_sr_list" | ssh -i "$key" -o IdentitiesOnly=yes -o BatchMode=yes \
        -o ConnectTimeout=3 -o UserKnownHostsFile="$known" -o StrictHostKeyChecking=yes \
        "$host" 2>/dev/null
}

# sem tela aqui (por ssh, sem X): o que der, no terminal
here() { [ -n "${DISPLAY:-}" ]; }
noscreen() { printf 'openfile: sem tela aqui para %s\n' "$1" >&2; return 1; }

handlenoextension() {
    case "$(mimetype "$1")" in
        inode/directory) echo "$1" ;;
        *) os_open "$@" ;;
    esac
}

first="$1"

test -L "$first" && first="$(abspath "$first")"

case "$(mimetype "$first")" in
    inode/x-empty|text/*|application/json|*shellscript|application/x-empty|application/octet-stream)
        if have nvim; then launch_nvim "$@"; else vi "$@"; fi ;;
    # documents open only in the terminal, with spdfv (sixel); never sent to
    # another screen. file calls DjVu image/, hence before image/*
    application/pdf|image/vnd.djvu*|application/vnd.djvu*|application/epub*)
        have spdfv && [ -t 0 ] || {
            printf 'openfile: documents open only in a terminal with spdfv: %s\n' "$first" >&2
            exit 1; }
        for _f in "$@"; do spdfv "$_f"; done ;;
    audio/*|video/x-ms-asf)
        send_remote "$@" || { have mpv && mpv --shuffle --no-audio-display "$@" || os_open "$@"; } ;;
    video/*)
        send_remote "$@" ||
            if here; then have mpv && mpv "$@" >/dev/null 2>&1 || os_open "$@"
            else have mpv && mpv --vo=tct --really-quiet "$@" || noscreen "$first"; fi ;;
    image/*)
        send_remote "$@" ||
            if here; then have nsxiv && nsxiv -a --thumbnail "$@" || os_open "$@"
            else for _f in "$@"; do preview "$_f"; done; fi ;;
	*) handlenoextension "$@" ;;
esac
