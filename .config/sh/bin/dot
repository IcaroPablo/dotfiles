#!/bin/sh
#
# dot — o que esta máquina tem e o que falta para a configuração funcionar.
#
# Só isso. Instalar é `make install` no repositório, que liga os symlinks;
# versionar é git dentro dele; ligar o shell são duas linhas no ~/.profile, que
# estão no README. Sobrou o relatório, que é o que nenhum dos três dá.
#
# POSIX sh only (dash/ksh/bash). Sem perl, sem bashismo.

_OK='✓'
_NO='✗'

have() { command -v "$1" >/dev/null 2>&1; }

MARK_BEGIN="# >>> icaro-dotfiles >>>"

usage() {
    cat <<'EOF'
dot relata o estado desta máquina: o que está instalado, o que falta, e se o
shell está ligado à configuração.

    dot            o relatório
    dot doctor     idem, para quem tem o dedo viciado

Instalar é `make install` no repositório; versionar é git dentro dele.
EOF
}

# ---------------------------------------------------------------- ferramentas

# present <cmd>: verdadeiro se a ferramenta (ou um substituto aceito) existe.
present() {
    case "$1" in
        fd)     have fd || have fdfind ;;
        zoxide) have zoxide || { have lua && [ -f "$HOME/.local/bin/z.lua" ]; } ;;
        *)      have "$1" ;;
    esac
}

# report_group <rótulo> <ferramenta...>: ✓/✗ por ferramenta, não-zero se faltar
# alguma. Sem instrução de instalação: cada máquina tem o seu gerenciador, e as
# tabelas por SO envelheciam mais rápido do que eram lidas.
report_group() {
    _label="$1"; shift
    _missing=""
    printf '%s\n  ' "$_label"
    for _t in "$@"; do
        if present "$_t"; then
            printf '%s %s  ' "$_OK" "$_t"
        else
            printf '%s %s  ' "$_NO" "$_t"
            _missing="$_missing $_t"
        fi
    done
    printf '\n\n'
    [ -z "$_missing" ]
}

# ---------------------------------------------------------------------- shell

detect_shell() {
    _sh="${SHELL:-}"
    [ -z "$_sh" ] && _sh="$(ps -p "$$" -o comm= 2>/dev/null)"
    basename "$_sh" 2>/dev/null
}

rc_path_for() {
    case "$1" in
        zsh)  printf '%s\n' "${ZDOTDIR:-$HOME}/.zshrc" ;;
        bash) printf '%s\n' "$HOME/.bashrc" ;;
        ksh|ksh93|oksh|mksh|pdksh|sh) printf '%s\n' "$HOME/.kshrc" ;;
        *)    printf '%s\n' "$HOME/.${1}rc" ;;
    esac
}

profile_path_for() {
    case "$1" in
        zsh)  printf '%s\n' "${ZDOTDIR:-$HOME}/.zprofile" ;;
        bash) printf '%s\n' "$HOME/.bash_profile" ;;
        *)    printf '%s\n' "$HOME/.profile" ;;
    esac
}

_block_status() {
    if [ -f "$1" ] && grep -qF "$MARK_BEGIN" "$1" 2>/dev/null; then
        printf '  %s %s\n' "$_OK" "$1"
    else
        printf '  %s %s\n' "$_NO" "$1"
    fi
}

# -------------------------------------------------------------------- relatório

doctor() {
    printf 'icaro-dotfiles :: doctor (%s)\n\n' "$(uname)"

    _core=1
    report_group "CORE" git fzf eza nvim tree-sitter bat file mktemp dvtm || _core=0
    report_group "NÚCLEO" fd zoxide readlink make lsof carapace || :
    report_group "PREVIEW (opcional — recursos degradam sem)" \
        w3m exiftool unzip tar pixterm || :

    # Outro repositório: github.com/IcaroPablo/posix-shell-scripts-collection,
    # instalado com `make install`. Sem ele o shpad não abre painel — o nvim
    # chama o create — e os atalhos do rc.sh ficam sem o comando por trás.
    report_group "COLEÇÃO (posix-shell-scripts-collection)" \
        create findfile simplegrep trash || :

    case "$(uname)" in
        Darwin)  report_group "OS/desktop (Darwin)" open || : ;;
        Linux)   report_group "OS/desktop (Linux)" xdg-open flatpak xclip || : ;;
        OpenBSD) report_group "OS/desktop (OpenBSD)" doas || : ;;
    esac

    # ksh e sh não têm rc interativo separado: o bloco mora só no profile, e é
    # o $ENV que aponta para o rc.sh. Cobrar um .kshrc que nunca vai existir é
    # alarme falso, e relatório que mente sobre uma linha perde a outra junto.
    _shell="$(detect_shell)"
    printf 'shell (%s)\n' "$_shell"
    case "$_shell" in
        ksh|ksh93|oksh|mksh|pdksh|sh) : ;;
        *) _block_status "$(rc_path_for "$_shell")" ;;
    esac
    _block_status "$(profile_path_for "$_shell")"

    printf '\n'
    if [ "$_core" = 1 ]; then
        printf 'CORE completo.\n'
        return 0
    fi
    printf 'falta dependência do CORE.\n'
    return 1
}

case "${1:-}" in
    ""|doctor) doctor ;;
    -h|--help|help) usage ;;
    *) printf 'dot: %s não é mais um verbo daqui\n\n' "$1" >&2; usage; exit 1 ;;
esac
