#!/bin/sh
#
# shpad - one editor pane, one shell pane, wired together.
#
# dvtm is here for layout and a title. It is not patched, and it is not on the
# path a command takes: the editor writes to a fifo and shpad-run reads it.

set -e

SHPAD_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/sh/shpad"
SHPAD_HISTORY="${SHPAD_HISTORY:-$HOME/.local/share/history.sh}"
# One fifo per session, named after this process -- which becomes dvtm's own pid
# at the exec below, and reaches both panes through the export. The same shape as
# the dvtm.$$.cmd path in rc.sh, and for the same reason.
#
# A single shared path was actively dangerous, not merely untidy: a second shpad
# would rm it and mkfifo a new one, leaving the first session's broker holding an
# unlinked inode nobody can address. Its editor then wrote to the new fifo, so
# commands typed in one window ran in another window's shell, in another
# directory, with the output nowhere in sight.
#
# Exporting SHPAD_FIFO yourself brings that back. Don't.
SHPAD_FIFO="${SHPAD_FIFO:-${XDG_RUNTIME_DIR:-$HOME/.cache}/shpad/fifo.$$}"

if [ ! -x "$SHPAD_HOME/shpad-run" ]; then
    printf 'shpad: not built yet -- run `make -C %s`\n' "$SHPAD_HOME" >&2
    exit 1
fi

mkdir -p "$(dirname "$SHPAD_FIFO")" "$(dirname "$SHPAD_HISTORY")"
[ -e "$SHPAD_HISTORY" ] || : > "$SHPAD_HISTORY"

# A fifo left behind by a previous session has no reader. Recreating it is
# cheaper than reasoning about which of the two ends is still alive.
rm -f "$SHPAD_FIFO"

export SHPAD_HOME SHPAD_HISTORY SHPAD_FIFO

# The editor goes LAST. attach() in dvtm prepends to the client list and tile()
# hands the master area to the head of it, so the window created last is the one
# that lands on the left. Reading the argument order as left-to-right gets this
# backwards, which is exactly the mistake that put the editor on the right.
#
# Window titles come from basename(args[0]), hence two bare script paths rather
# than a command with the history file in it -- that would title the window
# `history.sh'`, quote included.
#
# -c is not optional: it creates the command fifo and exports DVTM_CMD_FIFO to
# the panes, which is how nvim asks for a new pane. Same as the dvtm() wrapper
# in rc.sh, and without it that breaks inside a shpad session.
set -- -c "${TMPDIR:-/tmp}/dvtm.$$.cmd" -t shpad \
    "$SHPAD_HOME/shpad-run" "$SHPAD_HOME/shpad-edit"

# `env TERM=...`, and not `TERM=... dvtm`: the second form makes this shell load
# the description itself, and Apple's ncurses cannot read the direct-colour
# ones. The reasoning, and the variable, belong to rc.sh -- this only has to
# reach it, which is why DVTM_OUTER_TERM has to be exported there.
if [ -n "$DVTM_OUTER_TERM" ]; then
    exec env TERM="$DVTM_OUTER_TERM" dvtm "$@"
fi

exec dvtm "$@"
