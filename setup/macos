#!/bin/sh
# Fresh macOS -> my shell environment; no X, no window manager. Run as yourself,
# not root (Homebrew refuses root): sh setup/macos [capability...]. Without
# them it asks which to install. Safe to rerun.
set -e

user=$(id -un) home=$HOME ws=$HOME/Workspace
as_user() { sh -c "$1"; }
. "$(dirname "$(realpath "$0")")/lib.sh"

[ "$(uname)" = Darwin ] || { echo "setup/macos is for macOS" >&2; exit 1; }
[ "$(id -u)" -ne 0 ] || { echo "run as yourself, not root: Homebrew refuses root" >&2; exit 1; }

# asked first, so the rest runs unattended
choose_caps ghostty text-editing -- "$@"

# ==== 1. Apple's command line tools: git, make, cc ====

if ! xcode-select -p >/dev/null 2>&1; then
	xcode-select --install || :
	echo "finish the Command Line Tools install in its dialog, then run this again" >&2
	exit 1
fi

# ==== 2. Homebrew ====

# /opt/homebrew on Apple silicon, /usr/local on Intel
brew=
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$b" ] && { brew=$b; break; }; done
if [ -z "$brew" ]; then
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$b" ] && { brew=$b; break; }; done
	[ -n "$brew" ] || { echo "Homebrew didn't install" >&2; exit 1; }
fi
eval "$("$brew" shellenv)"

# what was installed before, to show at the end what this script doesn't install
before=$(brew leaves)
before_casks=$(brew list --cask)
wanted= casks=
add() { brew install "$@"; wanted="$wanted $*"; }
cask() { brew install --cask "$@"; casks="$casks $*"; }

brew update

# ==== 3. shell ====

# macOS already has file, zip, unzip, tar (with xz), realpath and man; p7zip,
# not sevenzip, is the one that installs a 7z command
add oksh git gh fzf eza fd ripgrep zoxide xz p7zip w3m exiftool chafa ffmpeg

# ==== 4. capabilities: what was chosen ====

# Homebrew's vis is vis, ahead of macOS's own vis(1) on the PATH
declared text-editing && add neovim tree-sitter-cli vis lua-language-server stylua
# with the font its config names
declared ghostty && cask ghostty font-monaspice-nerd-font

# ==== 5. dotfiles ====

mkdir -p "$ws"

github_url
clone dotfiles

declare_caps
(cd "$ws/dotfiles" && make install)

profile_block

# oksh as the login shell: chsh takes only what /etc/shells lists
oksh=$(brew --prefix)/bin/oksh
grep -qx "$oksh" /etc/shells || echo "$oksh" | sudo tee -a /etc/shells >/dev/null
[ "$(dscl . -read "/Users/$(id -un)" UserShell | sed 's/^UserShell: //')" = "$oksh" ] ||
	chsh -s "$oksh"

# ==== 6. leftovers ====

leftovers "already installed, not by this script (brew uninstall by hand if unwanted)" "$before" $wanted
leftovers "casks not from this script (brew uninstall --cask by hand if unwanted)" "$before_casks" $casks
