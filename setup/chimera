#!/bin/sh
# Fresh Chimera install -> my environment. Run as root, from a dotfiles clone
# or a copy of setup/: doas sh setup/chimera [capability...]. Without them it
# asks which to install. Safe to rerun.
set -e

user=meriadoc
host=shire
home=/home/$user
ws=$home/Workspace

[ "$(id -u)" -eq 0 ] || { echo "run as root: doas sh $0" >&2; exit 1; }

# ==== 1. preflight ====

echo "$host" > /etc/hostname
ln -sf /usr/share/zoneinfo/America/Fortaleza /etc/localtime

id "$user" >/dev/null 2>&1 || useradd -m "$user"

grep -q "^$user:[!*]" /etc/shadow && passwd "$user"

usermod -a -G wheel "$user"

as_user() { doas -u "$user" sh -c "$1"; }
. "$(dirname "$(realpath "$0")")/lib.sh"

# asked first, so the rest runs unattended
choose_caps x11 sixel text-editing vis host phone ocr yt-dlp -- "$@"

# what was installed before, to show at the end what this script doesn't install
before=$(cat /etc/apk/world)
before_apps=$(flatpak list --app --columns=application 2>/dev/null) || true
wanted=
add() { apk add "$@"; wanted="$wanted $*"; }

# ==== 2. system ====

add chimera-repo-user chimera-repo-contrib
apk update
apk upgrade

# what booting needs; already there after the first boot, needed in the chroot
add base-full chimerautils cryptsetup-scripts lvm2 \
	grub-x86_64-efi linux-stable networkmanager

# microcode and Intel's video decoding, for whatever this machine has
case $(grep -m1 vendor_id /proc/cpuinfo) in
*GenuineIntel*) ucode=ucode-intel ;;
*AuthenticAMD*) ucode=ucode-amd ;;
*) ucode= ;;
esac
# loaded early from the initramfs, which needs a rebuild once it's installed
if [ -n "$ucode" ]; then
	apk info -e "$ucode" >/dev/null 2>&1 || initramfs=stale
	add "$ucode"
fi
for d in /sys/bus/pci/devices/*; do
	case $(cat "$d/class"):$(cat "$d/vendor") in 0x03*:0x8086) add intel-media-driver ;; esac
done

# what this script itself uses
add git curl openssh

# stdin into the file $1, only when it differs from what the file holds;
# true when the file changed
changed() {
	[ ! -e "$1" ] || cp -p "$1" "$1.new"
	cat > "$1.new"
	if cmp -s "$1.new" "$1"; then rm "$1.new"; return 1; fi
	mv "$1.new" "$1"
}

# The system disk sits behind a JMicron USB-NVMe bridge. Its rule also goes
# into the initramfs: LUKS and LVM check for TRIM only when they open the
# disk, so the bridge must allow it by then
mkdir -p /etc/udev/rules.d
changed /etc/udev/rules.d/60-jmicron-nvme.rules <<'EOF' && initramfs=stale
# JMicron USB-NVMe enclosure (system disk):
# - STOP UNIT at shutdown, which the bridge turns into the NVMe shutdown notice;
#   without it every poweroff is unsafe
# - TRIM (unmap): the bridge supports it, but the kernel leaves it off
ACTION=="add", SUBSYSTEM=="scsi_disk", ATTRS{idVendor}=="152d", ATTRS{idProduct}=="0583", ATTR{manage_shutdown}="1", ATTR{provisioning_mode}="unmap"
EOF
for d in /sys/class/scsi_disk/*; do
	case $(cat "$d/device/../../../../idVendor" 2>/dev/null):$(cat "$d/device/../../../../idProduct" 2>/dev/null) in
	152d:0583)
		echo 1 > "$d/manage_shutdown"
		echo unmap > "$d/provisioning_mode" ;;
	esac
done

# TRIM through the disk encryption too
if [ -e /etc/crypttab ]; then
	awk '!/^[[:space:]]*#/ && NF >= 4 && $4 !~ /(^|,)discard(,|$)/ { $4 = $4 ",discard" } 1' \
		/etc/crypttab | changed /etc/crypttab && initramfs=stale
fi

# the microcode, the rule and crypttab reach early boot only through it
[ -z "${initramfs:-}" ] || update-initramfs -c -k all

# TRIM every mounted filesystem weekly, Sunday at midnight; when the machine
# was off then, at its next boot. snooze comes with dinit-chimera
add util-linux-fstrim
cat > /etc/dinit.d/fstrim <<'EOF'
type = process
command = /usr/lib/dinit-snooze "date; fstrim -av; touch /var/cache/snooze/fstrim" -w 0 -s 7d -t /var/cache/snooze/fstrim
restart = true
logfile = /var/log/fstrim.log
depends-on: local.target
EOF

# no dhcpcd (conflicts with NetworkManager)
for s in networkmanager syslog-ng fstrim; do
	[ -e "/etc/dinit.d/boot.d/$s" ] || dinitctl -o enable "$s"
done

# ==== 3. shell ====

add oksh github-cli fzf fd eza ripgrep zoxide file lsof htop llvm-binutils \
	7zip zip unzip xz unrar w3m exiftool chafa ffmpeg

as_user "mkdir -p $ws"

github_url
clone dotfiles

profile_block

chsh -s /usr/bin/oksh "$user"

# ==== 4. capabilities: what was chosen ====

declared text-editing && add neovim tree-sitter-cli
if declared vis; then
	# vis isn't in apk: built into ~/.local from master at a pinned commit, as
	# the 0.9 release needs a libtermkey apk lacks too. Installed as vise, its
	# BSD name, since chimerautils already has a vis(1)
	add lua5.4-lpeg clang gmake pkgconf ncurses-devel lua5.4-devel
	[ -x "$home/.local/bin/vise" ] || as_user 'd=$(mktemp -d) && cd "$d" &&
		curl -fsSL https://github.com/martanne/vis/archive/10b630af09404cf2c887e2d7e6e24ecda9d05ea7.tar.gz |
		tar -xz --strip-components=1 && ./configure --prefix=$HOME/.local && make && make install &&
		mv $HOME/.local/bin/vis $HOME/.local/bin/vise &&
		mv $HOME/.local/share/man/man1/vis.1 $HOME/.local/share/man/man1/vise.1; s=$?; rm -rf "$d"; exit $s'
fi
# no mupdf in apk, so spdfv opens PDF and DjVu here, not EPUB
declared sixel && add chafa ffmpeg python poppler djvulibre imagemagick
declared host && add rsync udisks
declared phone && add android-tools
declared ocr && add tesseract imagemagick
declared yt-dlp && add yt-dlp

if declared x11; then
	add xserver-xorg xinit mesa-dri xrandr xinput xset xrdb xmodmap xsetroot \
		xdpyinfo setxkbmap xclip xwallpaper dbus polkit elogind \
		xdg-desktop-portal xdg-desktop-portal-gtk pipewire pipewire-alsa \
		alsa-utils xdg-utils mpv thunar luakit gvfs thunar-volman udisks
	# rec-gif and rec-video's region picker
	add slop
	# audio-mirror reads PipeWire's events through it, and mpv's yt-dlp-wait
	# yt-dlp's answers
	add jq
	# mpv's DLNA browser (.config/mpv/scripts/dlna) talks through it
	add python

	# X applies this to every keyboard it adds, USB ones plugged in later too;
	# setxkbmap and xset in .xinitrc would only reach those already there
	mkdir -p /etc/X11/xorg.conf.d
	cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<'EOF'
Section "InputClass"
	Identifier "keyboard"
	MatchIsKeyboard "on"
	Option "XkbLayout" "br"
	# delay and interval, both in ms: xset r rate 300 100
	Option "AutoRepeat" "300 10"
EndSection
EOF

	# GTK records no list of the files you open (Thunar, luakit, the file
	# picker flatpaks use): ~/.local/share/recently-used.xbel stays empty
	mkdir -p /etc/xdg/gtk-3.0
	cat > /etc/xdg/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-recent-files-enabled=false
gtk-recent-files-max-age=0
EOF

	# st, sowm and scrot's build deps
	add clang gmake pkgconf linux-headers \
		libx11-devel libxft-devel libxinerama-devel imlib2-devel \
		libxcomposite-devel libxfixes-devel libxrandr-devel

	clone st
	clone sowm

	# /usr/local: build as user, install as root
	for r in st sowm; do
		as_user "cd $ws/$r && make"
		(cd "$ws/$r" && make install)
	done

	# checked as user so a copy in ~/.local/share/fonts counts
	if ! as_user 'fc-list : family | grep -q CozetteVector'; then
		mkdir -p /usr/local/share/fonts/cozette
		for f in CozetteVector.ttf CozetteVectorBold.ttf LICENSE; do
			curl -fL -o "/usr/local/share/fonts/cozette/$f" \
				"https://github.com/slavfox/Cozette/releases/download/v.1.30.0/$f"
		done
		fc-cache -f
	fi

	# build scrot from its release tarball into ~/.local (not in apk)
	[ -x "/home/$user/.local/bin/scrot" ] || as_user 'd=$(mktemp -d) && cd "$d" &&
		curl -fsSL https://github.com/resurrecting-open-source-projects/scrot/releases/download/2.0.0/scrot-2.0.0.tar.gz |
		tar -xz --strip-components=1 && ./configure --prefix=$HOME/.local && make install; s=$?; rm -rf "$d"; exit $s'

	# flatpaks
	add flatpak

	flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
	apps="io.github.ungoogled_software.ungoogled_chromium com.discordapp.Discord
		org.telegram.desktop com.stremio.Stremio org.godotengine.Godot
		com.github.tchx84.Flatseal com.valvesoftware.Steam"
	flatpak install -y --system flathub $apps

	# fails inside a chroot; rerun after boot
	apps="$apps com.teamspeak.TeamSpeak"
	flatpak install -y --system flathub com.teamspeak.TeamSpeak ||
		echo "warning: TeamSpeak not installed; rerun outside the chroot" >&2
	# screen-share audio capture talks to PipeWire directly, not through pulse
	flatpak override --system --filesystem=xdg-run/pipewire-0 com.teamspeak.TeamSpeak
fi

# ==== 5. dotfiles ====

declare_caps
# ~/.local/bin on the PATH, for make's checks: scrot lives there
as_user "PATH=\$HOME/.local/bin:\$PATH; cd $ws/dotfiles && make install"

# ==== 6. leftovers ====

# version constraints and repo tags off: foo>=1.2@user -> foo
leftovers "already installed, not by this script (apk del by hand if unwanted)" \
	"$(for p in $before; do echo "${p%%[<>=~@]*}"; done)" $wanted
leftovers "flatpaks not from this script (flatpak uninstall by hand if unwanted)" "$before_apps" $apps
